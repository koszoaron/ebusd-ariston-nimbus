# Copy to .env in the repository root (git-ignored) and fill in; then: chmod 600 .env
# Ariston NET cloud account (the same one the HACS integration uses). Read by the cloud-read
# tooling only; never printed or logged.
ARISTON_USERNAME=you@example.com
ARISTON_PASSWORD=change-me
# MQTT broker, a throwaway third user and Home Assistant's user, for ebus-mqttacl (checks that only
# ebusd may publish below ebusd/, and HA only the approved request topics). The test user needs no
# permissions beyond the defaults.
MQTT_HOST=mqtt.example
MQTT_PORT=1883
MQTT_TEST_USER=acltest
MQTT_TEST_PASS=change-me
MQTT_HASS_USER=ha-user-name
MQTT_HASS_PASS=change-me
